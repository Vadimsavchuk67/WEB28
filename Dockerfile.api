FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY проект/сервер/ .
RUN dotnet publish PostService/PostService.csproj -c Release -p:CopyLocalLockFileAssemblies=true -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out .
COPY проект/клієнт /app/wwwroot
ENV ASPNETCORE_URLS=http://+:8080
ENV WEB_ROOT=/app/wwwroot
ENV DATA_PATH=/data
EXPOSE 8080
ENTRYPOINT ["dotnet", "PostService.dll"]
